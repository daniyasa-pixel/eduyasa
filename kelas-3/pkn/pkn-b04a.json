        {
          "id": "K03-PKN-B04-M01-051",
          "type": "PG",
          "text": "Pada gambar pertama, lambang sila pertama adalah ...",
          "options": [
            "bintang",
            "rantai",
            "pohon beringin",
            "kapas"
          ],
          "answer": "bintang",
          "discussion": "Panel pertama memperlihatkan bintang.",
          "image": {
            "src": "https://raw.githubusercontent.com/daniyasa-pixel/eduyasa/main/kelas-3/pkn/assets/pkn-b04-gambar-01.svg",
            "alt": "Simbol pertama bintang, kedua rantai, ketiga pohon beringin."
          }
        },
        {
          "id": "K03-PKN-B04-M01-052",
          "type": "PG",
          "text": "Menurut urutan gambar, lambang sila kedua ialah ...",
          "options": [
            "kepala banteng",
            "rantai",
            "bintang",
            "pohon beringin"
          ],
          "answer": "rantai",
          "discussion": "Panel kedua memperlihatkan rantai.",
