          ],
          "answer": "2 2/7",
          "discussion": "8/3 : 7/6 = 8/3 x 6/7 = 48/21 = 16/7 = 2 2/7."
        },
        {
          "id": "MTK-B01-M01-025",
          "type": "PG",
          "text": "Di dalam keranjang terdapat 40 buah jeruk. 35% dari buah jeruk tersebut ternyata busuk. Banyak buah jeruk yang tidak busuk adalah...",
          "options": [
            "14 buah",
            "22 buah",
            "26 buah",
            "28 buah"
          ],
          "answer": "26 buah",
          "discussion": "Jeruk tidak busuk = 100% - 35% = 65%. Jumlah = 65/100 x 40 = 26 buah."
        },
