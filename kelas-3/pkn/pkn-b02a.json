        {
          "id": "K03-PKN-B02-M01-051",
          "type": "PG",
          "text": "Pada poster, apa yang perlu dilakukan sebelum berbicara?",
          "options": [
            "Mengangkat tangan",
            "Menutup telinga",
            "Mengetuk meja keras",
            "Meninggalkan kelas"
          ],
          "answer": "Mengangkat tangan",
          "discussion": "Poster memuat aturan angkat tangan.",
