    {
      "chapter_id": "MTK-B01",
      "chapter_title": "Bab 1: Pecahan dan Desimal",
      "questions": [
        {
          "id": "MTK-B01-M01-001",
          "type": "PG",
          "text": "Ibu membeli 3/4 kg gula pasir. Sebanyak 1/2 kg digunakan untuk membuat kue. Sisa gula pasir Ibu sekarang adalah...",
          "options": [
            "1/4 kg",
            "1/2 kg",
            "2/4 kg",
            "5/4 kg"
          ],
          "answer": "1/4 kg",
          "discussion": "Sisa gula = 3/4 - 1/2 = 3/4 - 2/4 = 1/4 kg."
        },
        {
          "id": "MTK-B01-M01-002",
          "type": "PG",
          "text": "Hasil dari 2 1/3 + 1 1/4 adalah...",
          "options": [
            "3 5/12",
            "3 7/12",
            "4 1/12",
            "3 1/6"
          ],
          "answer": "3 7/12",
          "discussion": "Ubah ke pecahan biasa: 7/3 + 5/4 = 28/12 + 15/12 = 43/12 = 3 7/12."
        },
        {
          "id": "MTK-B01-M01-003",
          "type": "PG",
          "text": "Bentuk desimal dari 3/8 adalah...",
          "options": [
            "0,25",
            "0,35",
            "0,375",
            "0,625"
          ],
          "answer": "0,375",
          "discussion": "3 dibagi 8 menggunakan pembagian bersusun menghasilkan 0,375."
        },
        {
          "id": "MTK-B01-M01-004",
          "type": "PG",
          "text": "Hasil dari 0,75 x 0,4 adalah...",
          "options": [
            "0,3",
            "0,03",
            "3,0",
            "0,35"
          ],
          "answer": "0,3",
          "discussion": "0,75 x 0,4 = 0,30 atau 0,3."
        },
        {
          "id": "MTK-B01-M01-005",
          "type": "PG",
          "text": "Bentuk paling sederhana dari 48/64 adalah...",
          "options": [
            "3/4",
            "2/3",
            "4/5",
            "5/8"
          ],
          "answer": "3/4",
          "discussion": "Pembilang dan penyebut dibagi dengan FPB dari 48 dan 64 yaitu 16, sehingga 48:16 / 64:16 = 3/4."
        },
        {
          "id": "MTK-B01-M01-006",
          "type": "PG",
          "text": "Hasil dari 4/5 : 2/3 adalah...",
          "options": [
            "8/15",
            "1 1/5",
            "1 2/5",
            "6/10"
          ],
          "answer": "1 1/5",
          "discussion": "4/5 : 2/3 = 4/5 x 3/2 = 12/10 = 6/5 = 1 1/5."
        },
        {
          "id": "MTK-B01-M01-007",
          "type": "PG",
          "text": "Urutan pecahan dari yang terkecil ke terbesar untuk 0,6; 3/4; 50%; 2/3 adalah...",
          "options": [
            "50%, 0,6, 2/3, 3/4",
            "50%, 2/3, 0,6, 3/4",
            "0,6, 50%, 2/3, 3/4",
            "2/3, 50%, 0,6, 3/4"
          ],
          "answer": "50%, 0,6, 2/3, 3/4",
          "discussion": "Ubah ke desimal: 50% = 0,5; 0,6 = 0,6; 2/3 = 0,67; 3/4 = 0,75. Urutannya: 0,5; 0,6; 0,67; 0,75."
        },
        {
          "id": "MTK-B01-M01-008",
          "type": "PG",
          "text": "Ayah memiliki pipa sepanjang 5 1/2 meter, kemudian dipotong 2 3/4 meter. Panjang sisa pipa Ayah adalah...",
          "options": [
            "2 1/4 meter",
            "2 3/4 meter",
            "3 1/4 meter",
            "3 3/4 meter"
          ],
          "answer": "2 3/4 meter",
          "discussion": "5 1/2 - 2 3/4 = 11/2 - 11/4 = 22/4 - 11/4 = 11/4 = 2 3/4 meter."
        },
        {
          "id": "MTK-B01-M01-009",
          "type": "PG",
          "text": "Hasil dari 1,25 + 3/4 adalah...",
          "options": [
            "1,75",
            "2,0",
            "2,25",
            "1,50"
          ],
          "answer": "2,0",
          "discussion": "3/4 diubah ke desimal menjadi 0,75. Maka 1,25 + 0,75 = 2,0."
        },
        {
          "id": "MTK-B01-M01-010",
          "type": "PG",
          "text": "Siti mempunyai pita sepanjang 2,5 meter. 1/5 bagian dari pita tersebut diberikan kepada Lani. Panjang pita yang diberikan kepada Lani adalah...",
          "options": [
            "0,2 meter",
            "0,5 meter",
            "1,0 meter",
            "1,25 meter"
          ],
          "answer": "0,5 meter",
          "discussion": "1/5 dari 2,5 = 1/5 x 2,5 = 0,5 meter."
        },
        {
          "id": "MTK-B01-M01-011",
          "type": "PG",
          "text": "Hasil dari 3 2/5 x 1 1/4 adalah...",
          "options": [
            "3 1/2",
            "4 1/4",
            "4 1/2",
            "5 1/4"
          ],
          "answer": "4 1/4",
          "discussion": "17/5 x 5/4 = 85/20 = 17/4 = 4 1/4."
        },
        {
          "id": "MTK-B01-M01-012",
          "type": "PG",
          "text": "Bentuk persen dari 7/20 adalah...",
          "options": [
            "14%",
            "25%",
            "35%",
            "70%"
          ],
          "answer": "35%",
          "discussion": "7/20 x 100% = 7 x 5% = 35%."
        },
        {
