        },
        {
          "id": "MTK-B01-M01-023",
          "type": "PG",
          "text": "Luas sebidang tanah adalah 120 m². Sebanyak 2/5 bagian digunakan untuk bangunan rumah dan sisanya untuk taman. Luas tanah untuk taman adalah...",
          "options": [
            "48 m²",
            "60 m²",
            "72 m²",
